{
  "name": "javastips",
  "version": "1.0.3",
  "description": "A TypeScript utility library with functional helpers, string tools, array helpers, math helpers, and basic algorithms.",
  "main": "dist/javastips.js",
  "types": "dist/bundle.d.ts",
  "type": "module",
  "files": [
    "/dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svngoku/JavasTips.git"
  },
  "keywords": [
    "javastips"
  ],
  "license": "MIT",
  "author": "Svngoku",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "webpack": "webpack",
    "build": "rimraf dist && tsc --emitDeclarationOnly && esbuild library/bundle.ts --bundle --format=iife --global-name=javastips --outfile=dist/javastips.js",
    "tsc": "tsc",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "esbuild": "^0.28.2",
    "esbuild-loader": "^4.5.0",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  }
}
